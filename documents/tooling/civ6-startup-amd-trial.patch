+fn prepare_amd_trial(p: &Paths) -> Result<(PathBuf, Vec<u8>, Vec<u8>, PathBuf), String> {
+    let options = p
+        .profile
+        .join("AppData/Local/Firaxis Games/Sid Meier's Civilization VI/AppOptions.txt");
+    let original = fs::read(&options).map_err(|e| format!("read AppOptions: {e}"))?;
+    let modified = replace_nvidia_with_amd(&original)?;
+    let backup_dir = p.here.join("startup-pr86-amd");
+    fs::create_dir_all(&backup_dir).map_err(|e| format!("create backup directory: {e}"))?;
+    let backup = backup_dir.join(format!("AppOptions.before-{}.bin", std::process::id()));
+    let mut file = OpenOptions::new()
+        .create_new(true)
+        .write(true)
+        .open(&backup)
+        .map_err(|e| format!("create AppOptions backup: {e}"))?;
+    file.write_all(&original)
+        .map_err(|e| format!("write AppOptions backup: {e}"))?;
+    file.sync_all()
+        .map_err(|e| format!("flush AppOptions backup: {e}"))?;
+    Ok((options, original, modified, backup))
+}
+
+fn replace_nvidia_with_amd(original: &[u8]) -> Result<Vec<u8>, String> {
+    let old = b"DeviceID 11141";
+    let mut positions = original
+        .windows(old.len())
+        .enumerate()
+        .filter_map(|(i, bytes)| {
+            let before = i == 0 || original[i - 1] == b'\n';
+            let end = i + old.len();
+            let after = end == original.len() || matches!(original[end], b'\r' | b'\n');
+            (bytes == old && before && after).then_some(i)
+        });
+    let at = positions
+        .next()
+        .ok_or("AppOptions lacks the exact NVIDIA DeviceID line")?;
+    if positions.next().is_some() {
+        return Err("AppOptions has duplicate NVIDIA DeviceID lines".into());
+    }
+    let mut modified = original.to_vec();
+    modified.splice(at..at + old.len(), b"DeviceID 5056".iter().copied());
+    Ok(modified)
+}
+
+#[cfg(test)]
+mod adapter_trial_tests {
+    use super::{prepare_amd_trial, replace_nvidia_with_amd};
+    use crate::Paths;
+    use std::{
+        fs,
+        time::{SystemTime, UNIX_EPOCH},
+    };
+
+    #[test]
+    fn changes_only_the_exact_line_and_keeps_line_endings() {
+        let before = b";DeviceID 11141\r\nDeviceID 11141\r\nOther 9\r\n";
+        let after = replace_nvidia_with_amd(before).unwrap();
+        assert_eq!(
+            after.as_slice(),
+            b";DeviceID 11141\r\nDeviceID 5056\r\nOther 9\r\n"
+        );
+    }
+
+    #[test]
+    fn rejects_missing_or_duplicate_device_lines() {
+        assert!(replace_nvidia_with_amd(b"DeviceID 5056\n").is_err());
+        assert!(replace_nvidia_with_amd(b"DeviceID 11141\nDeviceID 11141\n").is_err());
+    }
+
+    #[test]
+    fn backs_up_actual_bytes_inside_the_tool_directory_before_mutation() {
+        let nonce = SystemTime::now()
+            .duration_since(UNIX_EPOCH)
+            .unwrap()
+            .as_nanos();
+        let root = std::env::temp_dir().join(format!("todo974-amd-{nonce}"));
+        let mut paths = Paths::default();
+        paths.here = root.join("tool");
+        paths.profile = root.join("user");
+        let options = paths
+            .profile
+            .join("AppData/Local/Firaxis Games/Sid Meier's Civilization VI/AppOptions.txt");
+        fs::create_dir_all(options.parent().unwrap()).unwrap();
+        let source = b"Version 10\r\nDeviceID 11141\r\nFullScreen 0\r\n";
+        fs::write(&options, source).unwrap();
+        let (selected, original, modified, backup) = prepare_amd_trial(&paths).unwrap();
+        assert_eq!(selected, options);
+        assert_eq!(original.as_slice(), source);
+        assert_eq!(fs::read(&backup).unwrap().as_slice(), source);
+        assert_eq!(
+            backup.parent().unwrap(),
+            paths.here.join("startup-pr86-amd")
+        );
+        assert!(modified
+            .windows(b"DeviceID 5056".len())
+            .any(|w| w == b"DeviceID 5056"));
+        assert_eq!(fs::read(&options).unwrap(), source);
+        fs::remove_dir_all(root).unwrap();
+    }
+}
