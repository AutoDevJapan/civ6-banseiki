+        ]
+    );
+    assert!(scenario.merge_stderr);
+    assert!(!r.calls.iter().any(|c| c.args[0] == "fixture-python"));
+    assert_eq!(
+        r.calls.iter().filter(|c| c.args[0] == "taskkill").count(),
+        4
+    );
+    assert!(!f.p.here.join("civ6.lock").exists());
+}
