    {
      "code": "local A=assert(JAC_AbsorptionGameplay)\nlocal p=Players[Game.GetLocalPlayer()];local city=p:GetCities():GetCapitalCity();assert(city)\nlocal out={Owner=p:GetID(),City=city:GetID()}\nlocal ok,value=pcall(function() return city:GetCulturalIdentity():GetLoyalty() end)\nout.Direct={OK=ok,Value=ok and value or tostring(value)}\nlocal visit\nlocal vok,vvalue=pcall(function() return city:GetCulturalIdentity(function(ci)\n local t={Type=type(ci),Methods={}}\n for _,name in ipairs({'GetLoyalty','GetCurrentLoyalty','ChangeLoyalty','SetLoyalty'}) do t.Methods[name]=type(ci[name]) end\n if type(ci.GetLoyalty)=='function' then local good,v=pcall(function() return ci:GetLoyalty() end);t.ReadOK=good;t.Loyalty=good and v or nil;t.Error=not good and tostring(v) or nil end\n visit=t\nend) end)\nout.Visitor={OK=vok,ReturnType=type(vvalue),Result=visit,Error=not vok and tostring(vvalue) or nil}\nlocal sok,svalue=pcall(function() city:ChangeLoyalty(0);return true end)\nout.ZeroChange={OK=sok,Error=not sok and tostring(svalue) or nil}\nlocal objects={}\nfor _,pair in ipairs({{'Buildings',city,'GetBuildings'},{'PlayerCulture',p,'GetCulture'},{'GameCulture',Game,'GetCulture'},{'GreatPeople',Game,'GetGreatPeople'}}) do\n local present,obj=pcall(function() return pair[2][pair[3]](pair[2]) end)\n local methods={Accessible=present,ObjectType=type(obj)}\n if present and obj then for _,name in ipairs({'CreateGreatWork','RemoveGreatWork','MoveGreatWork','TransferGreatWork','SetGreatWork','SetGreatWorkInSlot','GetGreatWorkInSlot','GetNumGreatWorkSlots'}) do local good,v=pcall(function() return obj[name] end);methods[name]=good and type(v) or 'unavailable' end end\n objects[pair[1]]=methods\nend\nout.WorkObjects=objects\nprint('[JAC_ABSORPTION_CONTEXT_PROBE] '..A.Canonical(out))\nreturn A.Canonical(out)",
