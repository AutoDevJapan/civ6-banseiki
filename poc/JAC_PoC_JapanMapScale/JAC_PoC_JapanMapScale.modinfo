<?xml version="1.0" encoding="utf-8"?>
<Mod id="403be889-1455-4de7-967b-ad54c0ff3431" version="1">
  <Properties>
    <Name>LOC_JAC_JAPAN_SCALE_MOD_NAME</Name>
    <Teaser>LOC_JAC_JAPAN_SCALE_MOD_TEASER</Teaser>
    <Description>LOC_JAC_JAPAN_SCALE_MOD_DESCRIPTION</Description>
    <Authors>civ6-banseiki</Authors>
    <CompatibleVersions>2.0</CompatibleVersions>
  </Properties>
  <Dependencies>
    <Mod id="4873eb62-8ccc-4574-b784-dda455e74e68" title="LOC_EXPANSION2_MOD_TITLE"/>
    <Mod id="ba3a1c58-9287-4654-a22f-85f9e6841e9b" title="LOC_JAC_POC_CUSTOM_CIVS_MOD_NAME"/>
    <Mod id="bd7a82c5-6b38-4b69-a7f5-8dc9af534249" title="LOC_JAC_BANSEIKI_MOD_NAME"/>
  </Dependencies>
  <LocalizedText>
    <Text id="LOC_JAC_JAPAN_SCALE_MOD_NAME">
      <en_US>JAC PoC: Japan Map Scale</en_US>
      <ja_JP>JAC PoC：日本列島マップの縮尺</ja_JP>
      <ru_RU>JAC PoC: масштаб карты Японии</ru_RU>
    </Text>
    <Text id="LOC_JAC_JAPAN_SCALE_MOD_TEASER">
      <en_US>1534 Japan at 20 or 15 km with two start methods.</en_US>
      <ja_JP>1534年の日本列島。20・15 kmと2つの開始方法。</ja_JP>
      <ru_RU>Япония 1534 года: 20 или 15 км, два способа начала.</ru_RU>
    </Text>
    <Text id="LOC_JAC_JAPAN_SCALE_MOD_DESCRIPTION">
      <en_US>Choose historical territory or settlers in the map list; 22 Japan factions.</en_US>
      <ja_JP>地図一覧で「史実の領土」か「開拓者から」を選択。日本の22勢力。</ja_JP>
      <ru_RU>Выберите исторические владения или поселенцев в списке карт; 22 державы.</ru_RU>
    </Text>
  </LocalizedText>
  <ActionCriteria>
    <Criteria id="JAC_JapanMapScale_Banseiki">
      <RuleSetInUse>RULESET_JAC_BANSEIKI</RuleSetInUse>
    </Criteria>
    <Criteria id="JAC_Japan_20km_Historical">
      <RuleSetInUse>RULESET_JAC_BANSEIKI</RuleSetInUse>
      <ConfigurationValueMatches>
        <Group>Map</Group>
        <ConfigurationId>MAP_SCRIPT</ConfigurationId>
        <Value>{403be889-1455-4de7-967b-ad54c0ff3431}Maps/JAC_Japan_20km.Civ6Map</Value>
      </ConfigurationValueMatches>
    </Criteria>
    <Criteria id="JAC_Japan_15km_Historical">
      <RuleSetInUse>RULESET_JAC_BANSEIKI</RuleSetInUse>
      <ConfigurationValueMatches>
        <Group>Map</Group>
        <ConfigurationId>MAP_SCRIPT</ConfigurationId>
        <Value>{403be889-1455-4de7-967b-ad54c0ff3431}Maps/JAC_Japan_15km.Civ6Map</Value>
      </ConfigurationValueMatches>
    </Criteria>
    <Criteria id="JAC_Japan_20km_Settlers">
      <RuleSetInUse>RULESET_JAC_BANSEIKI</RuleSetInUse>
      <ConfigurationValueMatches>
        <Group>Map</Group>
        <ConfigurationId>MAP_SCRIPT</ConfigurationId>
        <Value>{403be889-1455-4de7-967b-ad54c0ff3431}Maps/JAC_Japan_20km_Settlers.Civ6Map</Value>
      </ConfigurationValueMatches>
    </Criteria>
    <Criteria id="JAC_Japan_15km_Settlers">
      <RuleSetInUse>RULESET_JAC_BANSEIKI</RuleSetInUse>
      <ConfigurationValueMatches>
        <Group>Map</Group>
        <ConfigurationId>MAP_SCRIPT</ConfigurationId>
        <Value>{403be889-1455-4de7-967b-ad54c0ff3431}Maps/JAC_Japan_15km_Settlers.Civ6Map</Value>
      </ConfigurationValueMatches>
    </Criteria>
  </ActionCriteria>
  <FrontEndActions>
    <ReplaceUIScript id="JAC_JapanMapScale_Staging_20km_Historical" criteria="JAC_Japan_20km_Historical">
      <Properties><LuaContext>StagingRoom</LuaContext><LuaReplace>UI/JAC_JapanStagingRoom.lua</LuaReplace></Properties>
    </ReplaceUIScript>
    <ReplaceUIScript id="JAC_JapanMapScale_Staging_15km_Historical" criteria="JAC_Japan_15km_Historical">
      <Properties><LuaContext>StagingRoom</LuaContext><LuaReplace>UI/JAC_JapanStagingRoom.lua</LuaReplace></Properties>
