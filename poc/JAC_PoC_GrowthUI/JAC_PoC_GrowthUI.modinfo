<?xml version="1.0" encoding="utf-8"?>
<Mod id="7696e937-2044-4f3c-8e13-4e27632e2710" version="1">
	<Properties>
		<Name>LOC_JAC_POC_GROWTHUI_MOD_NAME</Name>
		<Teaser>LOC_JAC_POC_GROWTHUI_MOD_TEASER</Teaser>
		<Description>LOC_JAC_POC_GROWTHUI_MOD_DESCRIPTION</Description>
		<Authors>civ6-banseiki</Authors>
		<CompatibleVersions>2.0</CompatibleVersions>
	</Properties>
	<LocalizedText>
		<Text id="LOC_JAC_POC_GROWTHUI_MOD_NAME">
			<en_US>JAC PoC: Growth and Warlord Ledger</en_US>
			<ja_JP>JAC PoC：成長と武将帳</ja_JP>
			<ru_RU>JAC PoC: развитие и журнал полководцев</ru_RU>
		</Text>
		<Text id="LOC_JAC_POC_GROWTHUI_MOD_TEASER">
			<en_US>Checks unit growth, save/load, UI and three languages.</en_US>
			<ja_JP>ユニット成長・保存・UI・3言語を検証する。</ja_JP>
			<ru_RU>Проверка развития юнитов, сохранения, интерфейса и трёх языков.</ru_RU>
		</Text>
		<Text id="LOC_JAC_POC_GROWTHUI_MOD_DESCRIPTION">
			<en_US>Assigns up to three starting units warlord records and displays them in a read-only ledger.</en_US>
			<ja_JP>開始時の最大3ユニットに武将記録を付け、読み取り専用の武将帳に表示する。</ja_JP>
			<ru_RU>Создаёт записи полководцев для трёх начальных юнитов и показывает их в журнале.</ru_RU>
		</Text>
	</LocalizedText>
	<ActionCriteria>
		<Criteria id="JAC_GrowthUI_GatheringStorm">
			<RuleSetInUse>RULESET_EXPANSION_2</RuleSetInUse>
		</Criteria>
	</ActionCriteria>
	<InGameActions>
		<UpdateText id="JAC_GrowthUI_Text" criteria="JAC_GrowthUI_GatheringStorm">
			<File>Text/JAC_PoC_GrowthUI_Text.xml</File>
		</UpdateText>
		<AddGameplayScripts id="JAC_GrowthUI_Gameplay" criteria="JAC_GrowthUI_GatheringStorm">
			<File>Scripts/JAC_PoC_GrowthUI_Gameplay.lua</File>
		</AddGameplayScripts>
		<AddUserInterfaces id="JAC_GrowthUI_InGameUI" criteria="JAC_GrowthUI_GatheringStorm">
			<Properties>
				<Context>InGame</Context>
			</Properties>
			<File>UI/JAC_PoC_GrowthUI.xml</File>
		</AddUserInterfaces>
		<ImportFiles id="JAC_GrowthUI_UIFiles" criteria="JAC_GrowthUI_GatheringStorm">
			<File>UI/JAC_PoC_GrowthUI.xml</File>
			<File>UI/JAC_PoC_GrowthUI.lua</File>
		</ImportFiles>
	</InGameActions>
	<Files>
		<File>Text/JAC_PoC_GrowthUI_Text.xml</File>
		<File>Scripts/JAC_PoC_GrowthUI_Gameplay.lua</File>
		<File>UI/JAC_PoC_GrowthUI.xml</File>
		<File>UI/JAC_PoC_GrowthUI.lua</File>
	</Files>
</Mod>
