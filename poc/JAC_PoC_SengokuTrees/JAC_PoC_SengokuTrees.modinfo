<?xml version="1.0" encoding="utf-8"?>
<Mod id="26c967d0-c10d-4eeb-8aaf-c83dc7e621e7" version="1">
	<Properties>
		<Name>LOC_JAC_SENGOKU_TREES_MOD_NAME</Name>
		<Teaser>LOC_JAC_SENGOKU_TREES_MOD_DESCRIPTION</Teaser>
		<Description>LOC_JAC_SENGOKU_TREES_MOD_DESCRIPTION</Description>
		<Authors>civ6-banseiki</Authors>
		<CompatibleVersions>2.0</CompatibleVersions>
	</Properties>
	<Dependencies>
		<Mod id="4873eb62-8ccc-4574-b784-dda455e74e68" title="LOC_EXPANSION2_MOD_TITLE"/>
		<Mod id="bd7a82c5-6b38-4b69-a7f5-8dc9af534249" title="LOC_JAC_BANSEIKI_MOD_NAME"/>
	</Dependencies>
	<LocalizedText>
		<Text id="LOC_JAC_SENGOKU_TREES_MOD_NAME">
			<en_US>JAC PoC: Sengoku Trees</en_US><ja_JP>JAC PoC：戦国ツリー</ja_JP><ru_RU>JAC PoC: древо Сэнгоку</ru_RU>
		</Text>
		<Text id="LOC_JAC_SENGOKU_TREES_MOD_DESCRIPTION">
			<en_US>Provisional technology and civic trees for the Banseiki ruleset.</en_US>
			<ja_JP>万世紀ルールセット専用の暫定技術・社会制度ツリー。</ja_JP>
			<ru_RU>Предварительные деревья технологий и общественных институтов для Бансэйки.</ru_RU>
		</Text>
	</LocalizedText>
	<ActionCriteria>
		<Criteria id="JAC_Sengoku_BanseikiOnly">
			<RuleSetInUse>RULESET_JAC_BANSEIKI</RuleSetInUse>
		</Criteria>
	</ActionCriteria>
	<InGameActions>
		<UpdateDatabase id="JAC_Sengoku_Trees" criteria="JAC_Sengoku_BanseikiOnly">
			<Properties><LoadOrder>200</LoadOrder></Properties>
			<File>Data/JAC_Sengoku_Calendar.xml</File>
			<File>Data/JAC_Sengoku_Trees.sql</File>
			<File>Data/JAC_Sengoku_Resources.sql</File>
			<File>Data/JAC_Sengoku_Cascade.sql</File>
			<File>Data/JAC_Sengoku_Unlocks.sql</File>
			<File>Data/JAC_Sengoku_Victories.sql</File>
			<File>Data/JAC_Sengoku_Unification.sql</File>
			<File>Data/JAC_Sengoku_Ages.sql</File>
			<File>Data/JAC_Sengoku_Reigns.sql</File>
		</UpdateDatabase>
		<AddGameplayScripts id="JAC_Sengoku_StartingKnowledge" criteria="JAC_Sengoku_BanseikiOnly">
			<File>Scripts/JAC_Sengoku_StartingKnowledge.lua</File>
		</AddGameplayScripts>
		<AddGameplayScripts id="JAC_Sengoku_Ages" criteria="JAC_Sengoku_BanseikiOnly">
			<File>Scripts/JAC_Sengoku_Ages.lua</File>
		</AddGameplayScripts>
		<AddGameplayScripts id="JAC_Sengoku_RebuiltCastles" criteria="JAC_Sengoku_BanseikiOnly">
			<File>Scripts/JAC_Sengoku_RebuiltCastles.lua</File>
		</AddGameplayScripts>
		<AddGameplayScripts id="JAC_Sengoku_UnificationPact" criteria="JAC_Sengoku_BanseikiOnly">
			<File>Scripts/JAC_Sengoku_UnificationPact.lua</File>
		</AddGameplayScripts>
		<AddUserInterfaces id="JAC_Sengoku_UnificationPactUI" criteria="JAC_Sengoku_BanseikiOnly">
			<Properties>
				<Context>InGame</Context>
			</Properties>
			<File>UI/JAC_UnificationPact.xml</File>
		</AddUserInterfaces>
		<AddUserInterfaces id="JAC_Sengoku_DarkPolicyUI" criteria="JAC_Sengoku_BanseikiOnly">
			<Properties>
				<Context>InGame</Context>
			</Properties>
			<File>UI/JAC_SengokuDarkPolicy.xml</File>
		</AddUserInterfaces>
		<AddUserInterfaces id="JAC_Sengoku_ReignPopupUI" criteria="JAC_Sengoku_BanseikiOnly">
			<Properties>
				<Context>InGame</Context>
			</Properties>
			<File>UI/JAC_SengokuReignPopup.xml</File>
		</AddUserInterfaces>
		<UpdateText id="JAC_Sengoku_Text" criteria="JAC_Sengoku_BanseikiOnly">
			<File>Text/JAC_Sengoku_Text.xml</File>
			<File>Text/JAC_Sengoku_Unification_Text.xml</File>
			<File>Text/JAC_Sengoku_Ages_Text.xml</File>
			<File>Text/JAC_Sengoku_Reigns_Text.xml</File>
		</UpdateText>
		<UpdateIcons id="JAC_Sengoku_Icons" criteria="JAC_Sengoku_BanseikiOnly">
			<File>Data/JAC_Sengoku_Icons.xml</File>
			<File>Data/JAC_Sengoku_Ages_Icons.xml</File>
		</UpdateIcons>
		<ImportFiles id="JAC_Sengoku_HouseNames" criteria="JAC_Sengoku_BanseikiOnly">
			<File>UI/JAC_HouseNamesData_Sengoku.lua</File>
			<File>UI/JAC_UnificationPact.xml</File>
			<File>UI/JAC_UnificationPact.lua</File>
			<File>UI/JAC_SengokuDarkPolicy.xml</File>
			<File>UI/JAC_SengokuDarkPolicy.lua</File>
			<File>UI/JAC_SengokuReignPopup.xml</File>
			<File>UI/JAC_SengokuReignPopup.lua</File>
			<File>UI/JAC_SengokuAgesView.lua</File>
			<!-- 時代スコアの画面：JAC_PoC_BanseikiRuleset の UI/JAC_EraProgressPanel.lua がワイルドカードで読む -->
			<File>UI/JAC_EraProgressPanel_Sengoku.lua</File>
			<File>UI/JAC_ActionPanel_Sengoku.lua</File>
		</ImportFiles>
		<!-- 右下の時代の目盛りの説明を元号にする。Gathering Storm の差し替え（LoadOrder なし = 0）の後に効かせる -->
		<ReplaceUIScript id="JAC_Sengoku_ActionPanel" criteria="JAC_Sengoku_BanseikiOnly">
			<Properties>
				<LoadOrder>100</LoadOrder>
				<LuaContext>ActionPanel</LuaContext>
				<LuaReplace>UI/JAC_ActionPanel_Sengoku.lua</LuaReplace>
			</Properties>
		</ReplaceUIScript>
	</InGameActions>
	<FrontEndActions>
		<UpdateDatabase id="JAC_Sengoku_VictorySettings">
			<Properties><LoadOrder>100</LoadOrder></Properties>
			<File>Config/JAC_Sengoku_Victories.xml</File>
			<File>Config/JAC_Sengoku_Calendar.xml</File>
		</UpdateDatabase>
		<UpdateText id="JAC_Sengoku_VictoryText">
			<File>Text/JAC_Sengoku_Unification_Text.xml</File>
		</UpdateText>
	</FrontEndActions>
	<Files>
		<File>Data/JAC_Sengoku_Calendar.xml</File>
		<File>Data/JAC_Sengoku_Trees.sql</File>
		<File>Data/JAC_Sengoku_Resources.sql</File>
		<File>Data/JAC_Sengoku_Cascade.sql</File>
		<File>Data/JAC_Sengoku_Unlocks.sql</File>
		<File>Data/JAC_Sengoku_Victories.sql</File>
		<File>Data/JAC_Sengoku_Unification.sql</File>
		<File>Data/JAC_Sengoku_Ages.sql</File>
		<File>Data/JAC_Sengoku_Reigns.sql</File>
		<File>Data/JAC_Sengoku_Ages_Icons.xml</File>
		<File>Scripts/JAC_Sengoku_Ages.lua</File>
		<File>Text/JAC_Sengoku_Ages_Text.xml</File>
		<File>Text/JAC_Sengoku_Reigns_Text.xml</File>
		<File>Scripts/JAC_Sengoku_StartingKnowledge.lua</File>
		<File>Scripts/JAC_Sengoku_RebuiltCastles.lua</File>
		<File>Scripts/JAC_Sengoku_UnificationPact.lua</File>
		<File>UI/JAC_UnificationPact.xml</File>
		<File>UI/JAC_UnificationPact.lua</File>
		<File>UI/JAC_SengokuDarkPolicy.xml</File>
		<File>UI/JAC_SengokuDarkPolicy.lua</File>
		<File>UI/JAC_SengokuReignPopup.xml</File>
		<File>UI/JAC_SengokuReignPopup.lua</File>
		<File>UI/JAC_SengokuAgesView.lua</File>
		<File>UI/JAC_EraProgressPanel_Sengoku.lua</File>
		<File>UI/JAC_ActionPanel_Sengoku.lua</File>
		<File>Data/JAC_Sengoku_Icons.xml</File>
		<File>Config/JAC_Sengoku_Victories.xml</File>
		<File>Config/JAC_Sengoku_Calendar.xml</File>
		<File>Text/JAC_Sengoku_Text.xml</File>
		<File>Text/JAC_Sengoku_Unification_Text.xml</File>
		<File>UI/JAC_HouseNamesData_Sengoku.lua</File>
	</Files>
</Mod>
