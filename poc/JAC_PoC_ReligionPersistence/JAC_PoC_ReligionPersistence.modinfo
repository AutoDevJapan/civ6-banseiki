<?xml version="1.0" encoding="utf-8"?>
<Mod id="9b0b9a39-bd72-4ff1-9062-05eeac09b693" version="1">
  <Properties>
    <Name>LOC_JAC_RP_MOD_NAME</Name>
    <Teaser>LOC_JAC_RP_MOD_DESCRIPTION</Teaser>
    <Description>LOC_JAC_RP_MOD_DESCRIPTION</Description>
    <Authors>civ6-banseiki</Authors>
    <CompatibleVersions>2.0</CompatibleVersions>
  </Properties>
  <Dependencies>
    <Mod id="4873eb62-8ccc-4574-b784-dda455e74e68" title="LOC_EXPANSION2_MOD_TITLE"/>
    <Mod id="bd7a82c5-6b38-4b69-a7f5-8dc9af534249" title="LOC_JAC_BANSEIKI_MOD_NAME"/>
    <Mod id="8424840c-92ef-4426-a9b4-b4e0cb818049" title="LOC_BABYLON_MOD_TITLE"/>
  </Dependencies>
  <LocalizedText>
    <Text id="LOC_JAC_RP_MOD_NAME">
      <ja_JP>JAC PoC 束2：宗教持続</ja_JP>
      <en_US>JAC PoC Bundle 2: Religion Persistence</en_US>
      <ru_RU>JAC PoC, блок 2: сохранение религий</ru_RU>
    </Text>
    <Text id="LOC_JAC_RP_MOD_DESCRIPTION">
      <ja_JP>仮宗教の信徒・地下化・滅亡・教典・再興を保存する検証用MOD。</ja_JP>
      <en_US>Verifies saved followers, underground continuity, loss, scriptures and revival using placeholder religions.</en_US>
      <ru_RU>Проверяет сохранение последователей, подполья, утраты, писаний и возрождения на условных религиях.</ru_RU>
    </Text>
  </LocalizedText>
  <ActionCriteria>
    <Criteria id="JAC_RP_BanseikiOnly">
      <RuleSetInUse>RULESET_JAC_BANSEIKI</RuleSetInUse>
    </Criteria>
    <Criteria id="JAC_RP_Autotest">
      <RuleSetInUse>RULESET_JAC_BANSEIKI</RuleSetInUse>
      <ConfigurationValueMatches>
        <Group>Game</Group>
        <ConfigurationId>JAC_AUTOTEST</ConfigurationId>
        <Value>1</Value>
      </ConfigurationValueMatches>
    </Criteria>
  </ActionCriteria>
  <InGameActions>
    <UpdateDatabase id="JAC_RP_Data" criteria="JAC_RP_BanseikiOnly">
      <Properties><LoadOrder>100</LoadOrder></Properties>
      <File>Data/JAC_ReligionPersistence.sql</File>
    </UpdateDatabase>
    <UpdateText id="JAC_RP_Text" criteria="JAC_RP_BanseikiOnly">
      <File>Text/JAC_ReligionPersistence_Text.xml</File>
    </UpdateText>
    <UpdateDatabase id="JAC_RP_TestDeadlines" criteria="JAC_RP_Autotest">
      <Properties><LoadOrder>150</LoadOrder></Properties>
      <File>Data/JAC_ReligionPersistence_Test.sql</File>
    </UpdateDatabase>
    <AddGameplayScripts id="JAC_RP_Gameplay" criteria="JAC_RP_BanseikiOnly">
      <Properties><LoadOrder>200</LoadOrder></Properties>
      <File>Scripts/JAC_ReligionPersistence.lua</File>
    </AddGameplayScripts>
  </InGameActions>
  <Files>
    <File>Data/JAC_ReligionPersistence.sql</File>
    <File>Data/JAC_ReligionPersistence_Test.sql</File>
    <File>Text/JAC_ReligionPersistence_Text.xml</File>
    <File>Scripts/JAC_ReligionPersistence.lua</File>
  </Files>
</Mod>
