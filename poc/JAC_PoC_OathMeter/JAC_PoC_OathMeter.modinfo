<?xml version="1.0" encoding="utf-8"?>
<Mod id="e4117d8c-4112-4f75-9a50-7d159e361fa4" version="1">
  <Properties><Name>JAC diagnostic oath meter</Name><Description>Controlled diagnostic inputs and a 100 percent reference; inactive until explicitly attached and activated.</Description><Authors>civ6-banseiki</Authors><CompatibleVersions>2.0</CompatibleVersions></Properties>
  <Dependencies><Mod id="26c967d0-c10d-4eeb-8aaf-c83dc7e621e7" title="Sengoku Trees"/></Dependencies>
  <ActionCriteria><Criteria id="JAC_OathMeter_Banseiki"><RuleSetInUse>RULESET_JAC_BANSEIKI</RuleSetInUse></Criteria><Criteria id="JAC_OathMeter_Headroom"><RuleSetInUse>RULESET_JAC_BANSEIKI</RuleSetInUse><ConfigurationValueMatches><Group>Game</Group><ConfigurationId>JAC_TODO134_QUEUE_HEADROOM</ConfigurationId><Value>1</Value></ConfigurationValueMatches></Criteria><Criteria id="JAC_OathMeter_Calibration"><RuleSetInUse>RULESET_JAC_BANSEIKI</RuleSetInUse><ConfigurationValueMatches><Group>Game</Group><ConfigurationId>JAC_TODO134_QUEUE_CALIBRATION</ConfigurationId><Value>1</Value></ConfigurationValueMatches></Criteria><Criteria id="JAC_OathMeter_TagPrerequisite"><RuleSetInUse>RULESET_JAC_BANSEIKI</RuleSetInUse><ConfigurationValueMatches><Group>Game</Group><ConfigurationId>JAC_TODO134_TAG_ERA_PREREQ</ConfigurationId><Value>1</Value></ConfigurationValueMatches></Criteria></ActionCriteria>
  <InGameActions><UpdateDatabase id="JAC_OathMeter_Data" criteria="JAC_OathMeter_Banseiki"><Properties><LoadOrder>300</LoadOrder></Properties><File>Data/Meter.sql</File></UpdateDatabase><UpdateDatabase id="JAC_OathMeter_Headroom_Data" criteria="JAC_OathMeter_Headroom"><Properties><LoadOrder>400</LoadOrder></Properties><File>Data/Headroom.sql</File></UpdateDatabase><UpdateDatabase id="JAC_OathMeter_Calibration_Data" criteria="JAC_OathMeter_Calibration"><Properties><LoadOrder>450</LoadOrder></Properties><File>Data/QueueCalibration.sql</File></UpdateDatabase><UpdateDatabase id="JAC_OathMeter_TagPrerequisite_Data" criteria="JAC_OathMeter_TagPrerequisite"><Properties><LoadOrder>460</LoadOrder></Properties><File>Data/TagEraPrerequisite.sql</File></UpdateDatabase></InGameActions>
  <FrontEndActions><UpdateDatabase id="JAC_OathMeter_Headroom_Config"><File>Config/Headroom.xml</File></UpdateDatabase><UpdateText id="JAC_OathMeter_Headroom_Text"><File>Text/Headroom.xml</File></UpdateText></FrontEndActions>
  <Files><File>Data/Meter.sql</File><File>Data/Headroom.sql</File><File>Data/QueueCalibration.sql</File><File>Config/Headroom.xml</File><File>Text/Headroom.xml</File><File>Data/TagEraPrerequisite.sql</File></Files>
