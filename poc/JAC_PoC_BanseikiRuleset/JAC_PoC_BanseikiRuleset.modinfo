<?xml version="1.0" encoding="utf-8"?>
<Mod id="bd7a82c5-6b38-4b69-a7f5-8dc9af534249" version="1">
	<Properties>
		<Name>LOC_JAC_BANSEIKI_MOD_NAME</Name>
		<Teaser>LOC_JAC_BANSEIKI_MOD_DESCRIPTION</Teaser>
		<Description>LOC_JAC_BANSEIKI_MOD_DESCRIPTION</Description>
		<Authors>civ6-banseiki</Authors>
		<CompatibleVersions>2.0</CompatibleVersions>
		<EnabledByDefault>1</EnabledByDefault>
	</Properties>
	<Dependencies>
		<Mod id="8424840C-92EF-4426-A9B4-B4E0CB818049" title="LOC_BABYLON_MOD_TITLE"/>
		<Mod id="4873eb62-8ccc-4574-b784-dda455e74e68" title="LOC_EXPANSION2_MOD_TITLE"/>
		<Mod id="ba3a1c58-9287-4654-a22f-85f9e6841e9b" title="LOC_JAC_POC_CUSTOM_CIVS_MOD_NAME"/>
	</Dependencies>
	<LocalizedText>
		<Text id="LOC_JAC_BANSEIKI_MOD_NAME">
			<en_US>JAC PoC: Banseiki Ruleset</en_US>
			<ja_JP>JAC PoC：万世紀ルールセット</ja_JP>
			<ru_RU>JAC PoC: правила Бансэйки</ru_RU>
		</Text>
		<Text id="LOC_JAC_BANSEIKI_MOD_DESCRIPTION">
			<en_US>Banseiki with Gathering Storm systems.</en_US>
			<ja_JP>Gathering Storm の仕組みを使う「万世紀」。</ja_JP>
			<ru_RU>Бансэйки с системами Gathering Storm.</ru_RU>
		</Text>
	</LocalizedText>
	<ActionCriteria>
		<Criteria id="JAC_Banseiki_Ruleset">
			<RuleSetInUse>RULESET_JAC_BANSEIKI</RuleSetInUse>
		</Criteria>
		<Criteria id="JAC_Banseiki_Heroes">
			<RuleSetInUse>RULESET_JAC_BANSEIKI</RuleSetInUse>
			<ConfigurationValueMatches><Group>Game</Group><ConfigurationId>GAMEMODE_HEROES</ConfigurationId><Value>1</Value></ConfigurationValueMatches>
		</Criteria>
	</ActionCriteria>
	<InGameActions>
		<UpdateDatabase id="JAC_Banseiki_HeroesData" criteria="JAC_Banseiki_Heroes">
			<Properties><LoadOrder>400</LoadOrder></Properties><File>Data/JAC_Banseiki_Heroes.sql</File>
		</UpdateDatabase>
		<UpdateText id="JAC_Banseiki_HeroesText" criteria="JAC_Banseiki_Heroes"><File>Text/JAC_Banseiki_Heroes_Text.xml</File></UpdateText>
		<UpdateIcons id="JAC_Banseiki_HeroesIcons" criteria="JAC_Banseiki_Heroes"><Properties><LoadOrder>400</LoadOrder></Properties><File>Data/JAC_Banseiki_Hero_Icons.sql</File></UpdateIcons>
		<UpdateArt id="JAC_Banseiki_HeroesArt" criteria="JAC_Banseiki_Heroes"><File>JAC_Banseiki_Heroes.dep</File></UpdateArt>
		<UpdateText id="JAC_Banseiki_InGameText" criteria="JAC_Banseiki_Ruleset">
			<File>Text/JAC_Banseiki_Text.xml</File>
		</UpdateText>
		<!-- 家固有名の表示切替（SSOT 3.2）。仕組みは documents/poc/house-names.md -->
		<ImportFiles id="JAC_Banseiki_HouseNamesFiles" criteria="JAC_Banseiki_Ruleset">
			<File>UI/JAC_HouseNames.lua</File>
			<File>UI/TechAndCivicUnlockables_JAC_HouseNames.lua</File>
			<File>UI/CivilopediaPage_JAC_HouseNames.lua</File>
			<File>UI/JAC_BoostUnlockedPopup.lua</File>
			<File>UI/JAC_EraProgressPanel.lua</File>
			<File>UI/JAC_EraCompletePopup.lua</File>
			<File>UI/JAC_EraReviewPopup.lua</File>
			<File>UI/JAC_DedicationPopup.lua</File>
			<File>UI/JAC_NewTurnPanel.lua</File>
			<File>UI/JAC_HistoricMoments.lua</File>
		</ImportFiles>
		<ReplaceUIScript id="JAC_Banseiki_BoostUnlockedPopup" criteria="JAC_Banseiki_Ruleset">
			<Properties>
				<LoadOrder>100</LoadOrder>
				<LuaContext>BoostUnlockedPopup</LuaContext>
				<LuaReplace>UI/JAC_BoostUnlockedPopup.lua</LuaReplace>
			</Properties>
		</ReplaceUIScript>
		<ReplaceUIScript id="JAC_Banseiki_EraProgressPanel" criteria="JAC_Banseiki_Ruleset">
			<Properties>
				<LoadOrder>100</LoadOrder>
				<LuaContext>EraProgressPanel</LuaContext>
				<LuaReplace>UI/JAC_EraProgressPanel.lua</LuaReplace>
			</Properties>
		</ReplaceUIScript>
		<ReplaceUIScript id="JAC_Banseiki_EraCompletePopup" criteria="JAC_Banseiki_Ruleset">
			<Properties>
				<LoadOrder>100</LoadOrder>
				<LuaContext>EraCompletePopup</LuaContext>
				<LuaReplace>UI/JAC_EraCompletePopup.lua</LuaReplace>
			</Properties>
		</ReplaceUIScript>
		<ReplaceUIScript id="JAC_Banseiki_EraReviewPopup" criteria="JAC_Banseiki_Ruleset">
			<Properties>
				<LoadOrder>100</LoadOrder>
				<LuaContext>EraReviewPopup</LuaContext>
				<LuaReplace>UI/JAC_EraReviewPopup.lua</LuaReplace>
			</Properties>
		</ReplaceUIScript>
		<ReplaceUIScript id="JAC_Banseiki_DedicationPopup" criteria="JAC_Banseiki_Ruleset">
			<Properties>
				<LoadOrder>100</LoadOrder>
				<LuaContext>DedicationPopup</LuaContext>
				<LuaReplace>UI/JAC_DedicationPopup.lua</LuaReplace>
			</Properties>
		</ReplaceUIScript>
		<ReplaceUIScript id="JAC_Banseiki_NewTurnPanel" criteria="JAC_Banseiki_Ruleset">
			<Properties>
				<LoadOrder>100</LoadOrder>
				<LuaContext>NewTurnPanel</LuaContext>
				<LuaReplace>UI/JAC_NewTurnPanel.lua</LuaReplace>
			</Properties>
		</ReplaceUIScript>
		<ReplaceUIScript id="JAC_Banseiki_HistoricMoments" criteria="JAC_Banseiki_Ruleset">
			<Properties>
				<LoadOrder>100</LoadOrder>
				<LuaContext>HistoricMoments</LuaContext>
				<LuaReplace>UI/JAC_HistoricMoments.lua</LuaReplace>
			</Properties>
		</ReplaceUIScript>
	</InGameActions>
	<FrontEndActions>
		<UpdateDatabase id="JAC_Banseiki_Settings">
			<File>Config/JAC_Banseiki_Config.xml</File>
		</UpdateDatabase>
		<UpdateText id="JAC_Banseiki_SettingsText">
			<File>Text/JAC_Banseiki_Text.xml</File>
		</UpdateText>
	</FrontEndActions>
	<Files>
		<File>Data/JAC_Banseiki_Heroes.sql</File>
		<File>Data/JAC_Banseiki_Hero_Icons.sql</File>
		<File>Text/JAC_Banseiki_Heroes_Text.xml</File>
		<File>JAC_Banseiki_Heroes.dep</File>
		<File>ArtDefs/Units.artdef</File>
		<File>Config/JAC_Banseiki_Config.xml</File>
		<File>Text/JAC_Banseiki_Text.xml</File>
		<File>UI/JAC_HouseNames.lua</File>
		<File>UI/TechAndCivicUnlockables_JAC_HouseNames.lua</File>
		<File>UI/CivilopediaPage_JAC_HouseNames.lua</File>
		<File>UI/JAC_BoostUnlockedPopup.lua</File>
		<File>UI/JAC_EraProgressPanel.lua</File>
		<File>UI/JAC_EraCompletePopup.lua</File>
		<File>UI/JAC_EraReviewPopup.lua</File>
		<File>UI/JAC_DedicationPopup.lua</File>
		<File>UI/JAC_NewTurnPanel.lua</File>
		<File>UI/JAC_HistoricMoments.lua</File>
	</Files>
</Mod>
