<?xml version="1.0" encoding="utf-8"?>
<Mod id="4a72b1c0-958b-4bd5-81e4-a094f86ce643" version="1">
  <Properties>
    <Name>JAC Test: Persona native boundaries</Name>
    <Description>Opt-in diagnostics for native spy neutralization, recovery and city loss. Unobserved results never count as success.</Description>
    <Authors>civ6-banseiki</Authors>
    <CompatibleVersions>2.0</CompatibleVersions>
  </Properties>
  <Dependencies>
    <Mod id="4873eb62-8ccc-4574-b784-dda455e74e68" title="Gathering Storm" />
    <Mod id="91cf7b65-54bb-4f69-a452-19a65527cde2" title="JAC PoC: Leader Persona" />
  </Dependencies>
  <ActionCriteria>
    <Criteria id="Boundary15"><RuleSetInUse>RULESET_JAC_BANSEIKI</RuleSetInUse><ConfigurationValueMatches><Group>Map</Group><ConfigurationId>MAP_SCRIPT</ConfigurationId><Value>Maps/JAC_Japan_15km.Civ6Map</Value></ConfigurationValueMatches></Criteria>
    <Criteria id="Boundary20"><RuleSetInUse>RULESET_JAC_BANSEIKI</RuleSetInUse><ConfigurationValueMatches><Group>Map</Group><ConfigurationId>MAP_SCRIPT</ConfigurationId><Value>Maps/JAC_Japan_20km.Civ6Map</Value></ConfigurationValueMatches></Criteria>
    <Criteria id="Boundary15Settlers"><RuleSetInUse>RULESET_JAC_BANSEIKI</RuleSetInUse><ConfigurationValueMatches><Group>Map</Group><ConfigurationId>MAP_SCRIPT</ConfigurationId><Value>Maps/JAC_Japan_15km_Settlers.Civ6Map</Value></ConfigurationValueMatches></Criteria>
    <Criteria id="Boundary20Settlers"><RuleSetInUse>RULESET_JAC_BANSEIKI</RuleSetInUse><ConfigurationValueMatches><Group>Map</Group><ConfigurationId>MAP_SCRIPT</ConfigurationId><Value>Maps/JAC_Japan_20km_Settlers.Civ6Map</Value></ConfigurationValueMatches></Criteria>
  </ActionCriteria>
  <InGameActions>
    <UpdateDatabase id="BoundaryCapacity15" criteria="Boundary15"><Properties><LoadOrder>901</LoadOrder></Properties><File>Data/JAC_PersonaBoundary_Capacity.sql</File></UpdateDatabase>
    <UpdateDatabase id="BoundaryCapacity20" criteria="Boundary20"><Properties><LoadOrder>901</LoadOrder></Properties><File>Data/JAC_PersonaBoundary_Capacity.sql</File></UpdateDatabase>
    <UpdateDatabase id="BoundaryCapacity15Settlers" criteria="Boundary15Settlers"><Properties><LoadOrder>901</LoadOrder></Properties><File>Data/JAC_PersonaBoundary_Capacity.sql</File></UpdateDatabase>
    <UpdateDatabase id="BoundaryCapacity20Settlers" criteria="Boundary20Settlers"><Properties><LoadOrder>901</LoadOrder></Properties><File>Data/JAC_PersonaBoundary_Capacity.sql</File></UpdateDatabase>
    <ImportFiles id="BoundaryImports">
      <File>Shared/JAC_PersonaBoundaryRules.lua</File>
      <File>UI/JAC_PersonaBoundary_View.lua</File>
      <File>UI/JAC_PersonaBoundary_View.xml</File>
    </ImportFiles>
    <AddGameplayScripts id="BoundaryFixture">
      <Properties><LoadOrder>900</LoadOrder></Properties>
      <File>Scripts/JAC_PersonaBoundary_Fixture.lua</File>
    </AddGameplayScripts>
    <AddUserInterfaces id="BoundaryObserver">
      <Properties><LoadOrder>900</LoadOrder><Context>InGame</Context></Properties>
      <File>UI/JAC_PersonaBoundary_View.xml</File>
    </AddUserInterfaces>
  </InGameActions>
  <Files>
    <File>Data/JAC_PersonaBoundary_Capacity.sql</File>
    <File>Shared/JAC_PersonaBoundaryRules.lua</File>
    <File>Scripts/JAC_PersonaBoundary_Fixture.lua</File>
    <File>UI/JAC_PersonaBoundary_View.lua</File>
    <File>UI/JAC_PersonaBoundary_View.xml</File>
  </Files>
</Mod>
