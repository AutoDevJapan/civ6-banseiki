  <LocalizedText>
    <Text id="LOC_JAC_ABSORPTION_MOD_NAME">
      <ja_JP>JAC PoC：勢力吸収</ja_JP><en_US>JAC PoC: Faction Absorption</en_US><ru_RU>JAC PoC: поглощение держав</ru_RU>
    </Text>
    <Text id="LOC_JAC_ABSORPTION_MOD_DESCRIPTION">
      <ja_JP>都市・部隊・人物・英雄・所持品・宗教を移管し、保存と読込を検証する PoC。</ja_JP>
      <en_US>A PoC for transferring cities, units, people, Heroes, belongings and religion, including save/load checks.</en_US>
      <ru_RU>Проверка передачи городов, войск, персонажей, героев, имущества и религии с сохранением и загрузкой.</ru_RU>
    </Text>
  </LocalizedText>
  <ActionCriteria><Criteria id="JAC_Absorption_Banseiki"><RuleSetInUse>RULESET_JAC_BANSEIKI</RuleSetInUse></Criteria></ActionCriteria>
  <InGameActions>
    <UpdateDatabase id="JAC_Absorption_Data" criteria="JAC_Absorption_Banseiki"><File>Data/JAC_Absorption.sql</File></UpdateDatabase>
    <UpdateText id="JAC_Absorption_Text" criteria="JAC_Absorption_Banseiki"><File>Text/JAC_Absorption_Text.xml</File></UpdateText>
    <ImportFiles id="JAC_Absorption_Rules"><File>Scripts/JAC_Absorption_Rules.lua</File></ImportFiles>
    <AddGameplayScripts id="JAC_Absorption_Gameplay" criteria="JAC_Absorption_Banseiki"><Properties><LoadOrder>200</LoadOrder></Properties><File>Scripts/JAC_Absorption_Gameplay.lua</File></AddGameplayScripts>
  </InGameActions>
  <Files>
    <File>Data/JAC_Absorption.sql</File><File>Text/JAC_Absorption_Text.xml</File>
    <File>Scripts/JAC_Absorption_Rules.lua</File><File>Scripts/JAC_Absorption_Gameplay.lua</File>
  </Files>
</Mod>
