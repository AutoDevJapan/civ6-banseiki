<?xml version="1.0" encoding="utf-8"?>
<Mod id="61320778-2e75-4c11-9009-94101b519aba" version="1">
  <Properties>
    <Name>LOC_JAC_ABSORPTION_MOD_NAME</Name>
    <Teaser>LOC_JAC_ABSORPTION_MOD_DESCRIPTION</Teaser>
    <Description>LOC_JAC_ABSORPTION_MOD_DESCRIPTION</Description>
    <Authors>civ6-banseiki</Authors><CompatibleVersions>2.0</CompatibleVersions>
  </Properties>
  <Dependencies>
    <Mod id="8424840C-92EF-4426-A9B4-B4E0CB818049" title="LOC_BABYLON_MOD_TITLE"/>
    <Mod id="4873eb62-8ccc-4574-b784-dda455e74e68" title="LOC_EXPANSION2_MOD_TITLE"/>
    <Mod id="bd7a82c5-6b38-4b69-a7f5-8dc9af534249" title="LOC_JAC_BANSEIKI_MOD_NAME"/>
    <Mod id="ba3a1c58-9287-4654-a22f-85f9e6841e9b" title="LOC_JAC_POC_CUSTOM_CIVS_MOD_NAME"/>
  </Dependencies>
  <LocalizedText>
    <Text id="LOC_JAC_ABSORPTION_MOD_NAME">
      <ja_JP>JAC PoC：勢力吸収</ja_JP><en_US>JAC PoC: Faction Absorption</en_US><ru_RU>JAC PoC: поглощение держав</ru_RU>
    </Text>
    <Text id="LOC_JAC_ABSORPTION_MOD_DESCRIPTION">
      <ja_JP>都市・部隊・人物・英雄・所持品・宗教を移管し、保存と読込を検証する PoC。</ja_JP>
      <en_US>A PoC for transferring cities, units, people, Heroes, belongings and religion, including save/load checks.</en_US>
      <ru_RU>Проверка передачи городов, войск, персонажей, героев, имущества и религии с сохранением и загрузкой.</ru_RU>
    </Text>
  </LocalizedText>
  <ActionCriteria>
    <Criteria id="JAC_Absorption_Banseiki"><RuleSetInUse>RULESET_JAC_BANSEIKI</RuleSetInUse></Criteria>
    <Criteria id="JAC_Absorption_ArtifactTest">
      <RuleSetInUse>RULESET_JAC_BANSEIKI</RuleSetInUse>
      <ConfigurationValueMatches>
        <Group>Game</Group><ConfigurationId>JAC_ABSORPTION_ARTIFACT_TEST</ConfigurationId><Value>1</Value>
      </ConfigurationValueMatches>
    </Criteria>
  </ActionCriteria>
  <FrontEndActions>
    <UpdateDatabase id="JAC_Absorption_ArtifactTest_Config"><File>Config/JAC_Absorption_ArtifactTest.xml</File></UpdateDatabase>
  </FrontEndActions>
  <InGameActions>
    <AddUserInterfaces id="JAC_Absorption_HeroKeys" criteria="JAC_Absorption_Banseiki"><Properties><Context>InGame</Context></Properties><File>UI/JAC_Absorption_HeroKeys.xml</File></AddUserInterfaces>
    <AddUserInterfaces id="JAC_Absorption_Flow_UI" criteria="JAC_Absorption_Banseiki"><Properties><Context>InGame</Context><LoadOrder>220</LoadOrder></Properties><File>UI/JAC_AbsorptionFlow.xml</File></AddUserInterfaces>
    <UpdateDatabase id="JAC_Absorption_Data" criteria="JAC_Absorption_Banseiki"><Properties><LoadOrder>300</LoadOrder></Properties><File>Data/JAC_Absorption.sql</File></UpdateDatabase>
    <UpdateDatabase id="JAC_Absorption_ArtifactTest_Data" criteria="JAC_Absorption_ArtifactTest"><Properties><LoadOrder>301</LoadOrder></Properties><File>Data/JAC_Absorption_ArtifactTest.sql</File></UpdateDatabase>
    <UpdateText id="JAC_Absorption_Text" criteria="JAC_Absorption_Banseiki"><File>Text/JAC_Absorption_Text.xml</File></UpdateText>
    <ImportFiles id="JAC_Absorption_Rules" criteria="JAC_Absorption_Banseiki"><File>Scripts/JAC_Absorption_Rules.lua</File></ImportFiles>
    <ImportFiles id="JAC_CarrierMP_UI" criteria="JAC_Absorption_Banseiki"><File>UI/JAC_CarrierMP_UI.lua</File></ImportFiles>
    <ImportFiles id="JAC_NativeInventory_UI" criteria="JAC_Absorption_Banseiki"><File>UI/JAC_NativeInventory_UI.lua</File></ImportFiles>
    <ImportFiles id="JAC_Absorption_Flow_Files" criteria="JAC_Absorption_Banseiki"><File>Scripts/JAC_Absorption_Flow.lua</File><File>UI/JAC_AbsorptionFlow.lua</File></ImportFiles>
    <ImportFiles id="JAC_Absorption_Engine_Files" criteria="JAC_Absorption_Banseiki"><File>Scripts/JAC_Absorption_Gameplay.lua</File><File>Scripts/JAC_CarrierBoundary.lua</File><File>Scripts/JAC_NativeInventory.lua</File><File>Scripts/JAC_Absorption_Admission.lua</File></ImportFiles>
    <ImportFiles id="JAC_Absorption_Product_Files" criteria="JAC_Absorption_Banseiki"><File>Scripts/JAC_Absorption_Product.lua</File></ImportFiles>
    <AddGameplayScripts id="JAC_Absorption_Gameplay" criteria="JAC_Absorption_Banseiki"><Properties><LoadOrder>200</LoadOrder></Properties><File>Scripts/JAC_Absorption_Entry.lua</File></AddGameplayScripts>
    <ImportFiles id="JAC_Absorption_Product_UI_Files" criteria="JAC_Absorption_Banseiki"><File>UI/JAC_Absorption_AdmissionUI.lua</File><File>UI/JAC_Absorption_CityStates.lua</File></ImportFiles>
    <ReplaceUIScript id="JAC_Absorption_Product_CityStates" criteria="JAC_Absorption_Banseiki"><Properties><LoadOrder>220</LoadOrder><LuaContext>CityStates</LuaContext><LuaReplace>UI/JAC_Absorption_CityStates.lua</LuaReplace></Properties></ReplaceUIScript>
    <UpdateText id="JAC_Absorption_Admission_Text" criteria="JAC_Absorption_Banseiki"><File>Text/JAC_Absorption_Admission_Text.xml</File></UpdateText>
    <ImportFiles id="JAC_Absorption_Product_NativeRead" criteria="JAC_Absorption_Banseiki"><File>UI/JAC_Absorption_ProductNativeRead.lua</File></ImportFiles>
  </InGameActions>
